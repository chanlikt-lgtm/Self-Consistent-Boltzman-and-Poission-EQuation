\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Self-consistent loop (40$\times $34), first 12 iterations. Potential update $17.7\to \SI {4.0}{mV}$; feedback suppresses $G_{ii}$ and $I_d$ with an \emph  {apparent} early plateau --- superseded by the 50-iteration study (\S  \ref {sec:giiconv}, Fig.~\ref {fig:conv50}), where $G_{ii}$ keeps falling.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:coupled}{{2}{7}{Self-consistent loop (40$\times $34), first 12 iterations. Potential update $17.7\to \SI {4.0}{mV}$; feedback suppresses $G_{ii}$ and $I_d$ with an \emph {apparent} early plateau --- superseded by the 50-iteration study (\S \ref {sec:giiconv}, Fig.~\ref {fig:conv50}), where $G_{ii}$ keeps falling}{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces $G_{ii,\max }$ [\si {cm^{-3}s^{-1}}] over grid $\times $ coupling (original device). The coupled column holds \emph  {under-converged snapshots}: the loop does not converge $G_{ii}$ (\S  \ref {sec:giiconv}, Fig.~\ref {fig:conv50}).}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:giimat}{{5}{7}{$G_{ii,\max }$ [\si {cm^{-3}s^{-1}}] over grid $\times $ coupling (original device). The coupled column holds \emph {under-converged snapshots}: the loop does not converge $G_{ii}$ (\S \ref {sec:giiconv}, Fig.~\ref {fig:conv50})}{table.caption.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Device recalibration and coupled-loop convergence study.}{7}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Recalibrated coupled 60$\times $50 convergence study --- \emph  {outer-iteration history} (50 iterations, $\phi $-damping $0.35$). Panels (b)--(d) show each outer iteration's SHE-solve observables on that iteration's \emph  {pre-update} potential, while (a) is the \emph  {subsequent} damped update $\max |\Delta \phi |$; the final saved fields rerun the SHE on the final damped $\phi $. (a) $\max |\Delta \phi |$ falls to \SI {2.5}{mV}, short of the \SI {2}{mV} criterion; (b) $G_{ii,\max }$ decreases monotonically with \emph  {no plateau} --- not converged in the outer loop; (c) $T_e$ drifts slowly downward; (d) $n$ and $I_d$ are essentially stable.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:conv50}{{3}{8}{Recalibrated coupled 60$\times $50 convergence study --- \emph {outer-iteration history} (50 iterations, $\phi $-damping $0.35$). Panels (b)--(d) show each outer iteration's SHE-solve observables on that iteration's \emph {pre-update} potential, while (a) is the \emph {subsequent} damped update $\max |\Delta \phi |$; the final saved fields rerun the SHE on the final damped $\phi $. (a) $\max |\Delta \phi |$ falls to \SI {2.5}{mV}, short of the \SI {2}{mV} criterion; (b) $G_{ii,\max }$ decreases monotonically with \emph {no plateau} --- not converged in the outer loop; (c) $T_e$ drifts slowly downward; (d) $n$ and $I_d$ are essentially stable}{figure.caption.11}{}}
