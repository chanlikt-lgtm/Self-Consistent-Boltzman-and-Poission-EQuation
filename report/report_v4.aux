\newlabel{fig:cmp}{{4}{9}{This work vs Liang Figs.~3 ($n$), 4 (velocity), 7 ($T_e$, $G_{ii}$ at Liang's contour levels)}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Quantitative Liang Fig.~7 overlay: our $T_e$ (dashed) and $G_{ii}$ (solid) on Liang's exact published levels; peaks reach $0.66$ ($T_e$) and $0.27$ ($G_{ii}$, unconverged) of the top contours.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ov7}{{5}{9}{Quantitative Liang Fig.~7 overlay: our $T_e$ (dashed) and $G_{ii}$ (solid) on Liang's exact published levels; peaks reach $0.66$ ($T_e$) and $0.27$ ($G_{ii}$, unconverged) of the top contours}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Potential $\phi $ (Liang Fig.~5) and hole concentration $p$ (Liang Fig.~6), recalibrated coupled 60$\times $50: $\phi $ rises smoothly source$\to $drain; holes fill the p-body and are depleted in the n$^+$ S/D.}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:pot}{{6}{10}{Potential $\phi $ (Liang Fig.~5) and hole concentration $p$ (Liang Fig.~6), recalibrated coupled 60$\times $50: $\phi $ rises smoothly source$\to $drain; holes fill the p-body and are depleted in the n$^+$ S/D}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Energy distribution (Liang Fig.~2): a hot, non-Maxwellian tail localized at the drain surface, thermal in the bulk.}}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:dist}{{7}{10}{Energy distribution (Liang Fig.~2): a hot, non-Maxwellian tail localized at the drain surface, thermal in the bulk}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Terminal I-V (Liang Fig.~8), drift-diffusion proxy, per micron: (a) subthreshold transfer at $V_{ds}=0.25,\SI {0.5}{V}$; (b) output characteristic at $V_{gs}=2.0,2.5,\SI {3.0}{V}$.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:iv}{{8}{10}{Terminal I-V (Liang Fig.~8), drift-diffusion proxy, per micron: (a) subthreshold transfer at $V_{ds}=0.25,\SI {0.5}{V}$; (b) output characteristic at $V_{gs}=2.0,2.5,\SI {3.0}{V}$}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Terminal I-V from the \emph  {SHE velocity moment} (finite-volume face-flux current --- Liang's method), one-way SHE on the DD potential, vs the DD proxy (dashed); recalibrated device, 40$\times $34. (a) subthreshold at $V_{ds}=\SI {0.5}{V}$ \emph  {only} --- a partial reproduction of Liang's Fig.~8(a), which also shows \SI {0.25}{V}; (b) output families $V_{gs}=2.0,2.5,\SI {3.0}{V}$. Source/drain current conservation $|I_{src}{+}I_{drn}|/\overline  {|I|}$ is $2\times 10^{-5}$--$10^{-3}$ across the sweep (largest at $V_{ds}=\SI {3}{V}$), so the reported current is the genuine SHE terminal flux. The \emph  {measured} ratio $I_{d,\text  {SHE}}/I_{d,\text  {DD}}$ is $0.51$--$0.54$ (subthreshold) and $0.60$--$0.96$ (output, rising toward unity at high $V_{gs}$/$V_{ds}$): the SHE current is systematically below the mobility-based DD proxy, consistent with the stronger nonlocal/high-field transport in the SHE solution (not attributed to a single mechanism absent a controlled diagnostic).}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ivmoment}{{9}{11}{Terminal I-V from the \emph {SHE velocity moment} (finite-volume face-flux current --- Liang's method), one-way SHE on the DD potential, vs the DD proxy (dashed); recalibrated device, 40$\times $34. (a) subthreshold at $V_{ds}=\SI {0.5}{V}$ \emph {only} --- a partial reproduction of Liang's Fig.~8(a), which also shows \SI {0.25}{V}; (b) output families $V_{gs}=2.0,2.5,\SI {3.0}{V}$. Source/drain current conservation $|I_{src}{+}I_{drn}|/\overline {|I|}$ is $2\times 10^{-5}$--$10^{-3}$ across the sweep (largest at $V_{ds}=\SI {3}{V}$), so the reported current is the genuine SHE terminal flux. The \emph {measured} ratio $I_{d,\text {SHE}}/I_{d,\text {DD}}$ is $0.51$--$0.54$ (subthreshold) and $0.60$--$0.96$ (output, rising toward unity at high $V_{gs}$/$V_{ds}$): the SHE current is systematically below the mobility-based DD proxy, consistent with the stronger nonlocal/high-field transport in the SHE solution (not attributed to a single mechanism absent a controlled diagnostic)}{figure.caption.17}{}}
