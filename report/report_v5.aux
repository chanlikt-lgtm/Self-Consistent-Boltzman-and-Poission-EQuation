\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Self-consistent loop (40$\times $34), first 12 \emph  {damped-Picard} iterations. Potential update $17.7\to \SI {4.0}{mV}$; feedback suppresses $G_{ii}$ and $I_d$ with an \emph  {apparent} early plateau that does not survive (Picard stalls, Fig.~\ref {fig:conv50}); the converged loop uses the stagnation-restart Anderson solver (\S  \ref {sec:giiconv}, Fig.~\ref {fig:anderson}).}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:coupled}{{2}{7}{Self-consistent loop (40$\times $34), first 12 \emph {damped-Picard} iterations. Potential update $17.7\to \SI {4.0}{mV}$; feedback suppresses $G_{ii}$ and $I_d$ with an \emph {apparent} early plateau that does not survive (Picard stalls, Fig.~\ref {fig:conv50}); the converged loop uses the stagnation-restart Anderson solver (\S \ref {sec:giiconv}, Fig.~\ref {fig:anderson})}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}$G_{ii}$ convergence matrix and device recalibration}{7}{section.9}\protected@file@percent }
\newlabel{sec:giiconv}{{9}{7}{$G_{ii}$ convergence matrix and device recalibration}{section.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces $G_{ii,\max }$ [\si {cm^{-3}s^{-1}}] over grid $\times $ coupling (recalibrated device, $\Phi _{gate}=\SI {-0.74}{V}$). The coupled column holds \emph  {converged} fixed-point values (stagnation-restart Anderson, Fig.~\ref {fig:anderson}); the one-way column is iteration~0 of the same loop (SHE on the recalibrated DD potential). Both fall with refinement; the converged coupled value is $-69\%$ from 40$\times $34 to 60$\times $50.}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:giimat}{{5}{7}{$G_{ii,\max }$ [\si {cm^{-3}s^{-1}}] over grid $\times $ coupling (recalibrated device, $\Phi _{gate}=\SI {-0.74}{V}$). The coupled column holds \emph {converged} fixed-point values (stagnation-restart Anderson, Fig.~\ref {fig:anderson}); the one-way column is iteration~0 of the same loop (SHE on the recalibrated DD potential). Both fall with refinement; the converged coupled value is $-69\%$ from 40$\times $34 to 60$\times $50}{table.caption.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Device recalibration and the converged coupled loop.}{7}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The \emph  {damped-Picard} 60$\times $50 loop stalls (50 iterations, $\phi $-damping $0.35$): (a) $\max |\Delta \phi |$ falls only to \SI {2.5}{mV}; (b) $G_{ii,\max }$ drifts monotonically with \emph  {no plateau}; (c) $T_e$ drifts down; (d) $n$, $I_d$ stable. This slow non-convergence motivated the stagnation-restart Anderson solver (Fig.~\ref {fig:anderson}), which reaches the fixed point Picard could not.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:conv50}{{3}{8}{The \emph {damped-Picard} 60$\times $50 loop stalls (50 iterations, $\phi $-damping $0.35$): (a) $\max |\Delta \phi |$ falls only to \SI {2.5}{mV}; (b) $G_{ii,\max }$ drifts monotonically with \emph {no plateau}; (c) $T_e$ drifts down; (d) $n$, $I_d$ stable. This slow non-convergence motivated the stagnation-restart Anderson solver (Fig.~\ref {fig:anderson}), which reaches the fixed point Picard could not}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}Quantitative comparison with Liang's published figures}{8}{section.10}\protected@file@percent }
\newlabel{sec:compare}{{10}{8}{Quantitative comparison with Liang's published figures}{section.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Stagnation-restart Anderson acceleration of the coupled loop. (a) fixed-point residual $\max |G(\phi )-\phi |$; (b) $G_{ii,\max }$; (c) $T_{e,\max }$; (d) $I_d$. Baseline Anderson (rcond~$10^{-12}$, no restart; red) stalls like Picard; the restart-plus-regularized solver converges $G_{ii}$ to a flat plateau at 40$\times $34 (green, $7.44\times 10^{26}$) and 60$\times $50 (blue, $2.29\times 10^{26}$). Both grids plateau, but at strongly grid-dependent levels; $I_d$~(d) is mesh-robust.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:anderson}{{4}{9}{Stagnation-restart Anderson acceleration of the coupled loop. (a) fixed-point residual $\max |G(\phi )-\phi |$; (b) $G_{ii,\max }$; (c) $T_{e,\max }$; (d) $I_d$. Baseline Anderson (rcond~$10^{-12}$, no restart; red) stalls like Picard; the restart-plus-regularized solver converges $G_{ii}$ to a flat plateau at 40$\times $34 (green, $7.44\times 10^{26}$) and 60$\times $50 (blue, $2.29\times 10^{26}$). Both grids plateau, but at strongly grid-dependent levels; $I_d$~(d) is mesh-robust}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces This work vs Liang Figs.~3 ($n$), 4 (velocity), 7 ($T_e$, $G_{ii}$ at Liang's contour levels).}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cmp}{{5}{10}{This work vs Liang Figs.~3 ($n$), 4 (velocity), 7 ($T_e$, $G_{ii}$ at Liang's contour levels)}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Quantitative Liang Fig.~7 overlay: our $T_e$ (dashed) and $G_{ii}$ (solid) on Liang's exact published levels; peaks reach $0.62$ ($T_e$) and $0.10$ ($G_{ii}$, mesh-unconverged) of the top contours.}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:ov7}{{6}{10}{Quantitative Liang Fig.~7 overlay: our $T_e$ (dashed) and $G_{ii}$ (solid) on Liang's exact published levels; peaks reach $0.62$ ($T_e$) and $0.10$ ($G_{ii}$, mesh-unconverged) of the top contours}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Potential $\phi $ (Liang Fig.~5) and hole concentration $p$ (Liang Fig.~6), recalibrated coupled 60$\times $50: $\phi $ rises smoothly source$\to $drain; holes fill the p-body and are depleted in the n$^+$ S/D.}}{11}{figure.caption.15}\protected@file@percent }
\newlabel{fig:pot}{{7}{11}{Potential $\phi $ (Liang Fig.~5) and hole concentration $p$ (Liang Fig.~6), recalibrated coupled 60$\times $50: $\phi $ rises smoothly source$\to $drain; holes fill the p-body and are depleted in the n$^+$ S/D}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Energy distribution (Liang Fig.~2): a hot, non-Maxwellian tail localized at the drain surface, thermal in the bulk.}}{11}{figure.caption.16}\protected@file@percent }
\newlabel{fig:dist}{{8}{11}{Energy distribution (Liang Fig.~2): a hot, non-Maxwellian tail localized at the drain surface, thermal in the bulk}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Terminal I-V (Liang Fig.~8), drift-diffusion proxy, per micron: (a) subthreshold transfer at $V_{ds}=0.25,\SI {0.5}{V}$; (b) output characteristic at $V_{gs}=2.0,2.5,\SI {3.0}{V}$.}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:iv}{{9}{11}{Terminal I-V (Liang Fig.~8), drift-diffusion proxy, per micron: (a) subthreshold transfer at $V_{ds}=0.25,\SI {0.5}{V}$; (b) output characteristic at $V_{gs}=2.0,2.5,\SI {3.0}{V}$}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Terminal I-V from the \emph  {SHE velocity moment} (finite-volume face-flux current --- Liang's method), one-way SHE on the DD potential, vs the DD proxy (dashed); recalibrated device, 40$\times $34. (a) subthreshold at $V_{ds}=\SI {0.5}{V}$ \emph  {only} --- a partial reproduction of Liang's Fig.~8(a), which also shows \SI {0.25}{V}; (b) output families $V_{gs}=2.0,2.5,\SI {3.0}{V}$. Source/drain current conservation $|I_{src}{+}I_{drn}|/\overline  {|I|}$ is $2\times 10^{-5}$--$10^{-3}$ across the sweep (largest at $V_{ds}=\SI {3}{V}$), so the reported current is the genuine SHE terminal flux. The \emph  {measured} ratio $I_{d,\text  {SHE}}/I_{d,\text  {DD}}$ is $0.51$--$0.54$ (subthreshold) and $0.60$--$0.96$ (output, rising toward unity at high $V_{gs}$/$V_{ds}$): the SHE current is systematically below the mobility-based DD proxy, consistent with the stronger nonlocal/high-field transport in the SHE solution (not attributed to a single mechanism absent a controlled diagnostic).}}{12}{figure.caption.18}\protected@file@percent }
\newlabel{fig:ivmoment}{{10}{12}{Terminal I-V from the \emph {SHE velocity moment} (finite-volume face-flux current --- Liang's method), one-way SHE on the DD potential, vs the DD proxy (dashed); recalibrated device, 40$\times $34. (a) subthreshold at $V_{ds}=\SI {0.5}{V}$ \emph {only} --- a partial reproduction of Liang's Fig.~8(a), which also shows \SI {0.25}{V}; (b) output families $V_{gs}=2.0,2.5,\SI {3.0}{V}$. Source/drain current conservation $|I_{src}{+}I_{drn}|/\overline {|I|}$ is $2\times 10^{-5}$--$10^{-3}$ across the sweep (largest at $V_{ds}=\SI {3}{V}$), so the reported current is the genuine SHE terminal flux. The \emph {measured} ratio $I_{d,\text {SHE}}/I_{d,\text {DD}}$ is $0.51$--$0.54$ (subthreshold) and $0.60$--$0.96$ (output, rising toward unity at high $V_{gs}$/$V_{ds}$): the SHE current is systematically below the mobility-based DD proxy, consistent with the stronger nonlocal/high-field transport in the SHE solution (not attributed to a single mechanism absent a controlled diagnostic)}{figure.caption.18}{}}
